@using WebClient.Common

@if (Response is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable T="SearchActors.ActorSummary" Items="Response.Actors" Hover="true" OnRowClick="OnRowClicked">
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel T="SearchActors.ActorSummary"
                                    SortDirection="@(SortByDescending ? SortDirection.Descending : SortDirection.Ascending)"
                                    SortDirectionChanged="@(direction => SortByDescendingChanged.InvokeAsync(direction == SortDirection.Descending))">
                    Name
                </MudTableSortLabel>
            </MudTh>
        </HeaderContent>
        <RowTemplate Context="actor">
            <MudTd>@actor.Name</MudTd>
        </RowTemplate>
    </MudTable>

    <Pagination PageNumber="Response.PageNumber"
                PageSize="Response.PageSize"
                TotalPages="Response.TotalPages"
                PageNumberChanged="PageNumberChanged"
                PageSizeChanged="PageSizeChanged" />
}
