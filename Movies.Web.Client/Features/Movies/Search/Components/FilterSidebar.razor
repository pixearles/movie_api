@using WebClient.Common
@using WebClient.Features.Actors.Search
@using WebClient.Features.Genres.GetAll

<MudText Typo="Typo.subtitle2" Class="mb-1">Sort by</MudText>
<div class="d-flex flex-column mb-4" style="width:100%; border:1px solid #455A64; border-radius:8px; overflow:hidden;">
    <MudButton Variant="Variant.Text"
               StartIcon="@SortIconFor(MovieSortColumn.Title)"
               Style="@($"border-bottom:1px solid #455A64; {SortButtonStyle(MovieSortColumn.Title)}")"
               OnClick="@(() => SearchState.SetMovieSort(MovieSortColumn.Title))">
        Title
    </MudButton>
    <MudButton Variant="Variant.Text"
               StartIcon="@SortIconFor(MovieSortColumn.ReleaseDate)"
               Style="@SortButtonStyle(MovieSortColumn.ReleaseDate)"
               OnClick="@(() => SearchState.SetMovieSort(MovieSortColumn.ReleaseDate))">
        Release Date
    </MudButton>
</div>

<MudText Typo="Typo.subtitle2" Class="mb-1">Filter by</MudText>
<MudExpansionPanels MultiExpansion="true">
    <MudExpansionPanel Text="Genres" Expanded="true">
        @if (_genres is null)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            @foreach (var genre in _genres)
            {
                <MudCheckBox T="bool" Label="@genre.Name"
                             Value="SearchState.SelectedGenreIds.Contains(genre.Id)"
                             ValueChanged="@(_ => OnGenreToggled(genre.Id))" />
            }
        }
    </MudExpansionPanel>

    <MudExpansionPanel Text="Actors">
        @if (SearchState.SelectedActors.Count > 0)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                @foreach (var actor in SearchState.SelectedActors)
                {
                    <MudChip T="string" OnClose="@(_ => OnActorFilterRemoved(actor.Id))">@actor.Name</MudChip>
                }
            </MudStack>
        }

        <MudAutocomplete T="SearchActors.ActorSummary"
                          Value="_actorSearchValue"
                          Label="Search actors"
                          SearchFunc="SearchActorsAsync"
                          ToStringFunc="@(a => a?.Name ?? string.Empty)"
                          ValueChanged="OnActorSelected"
                          Clearable="true" />
    </MudExpansionPanel>
</MudExpansionPanels>
